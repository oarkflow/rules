bcl { version "1.0" strict true }

version "2"
environment "example"
metadata { owner "platform-sre" domain "blast-radius-demo" }

reason_code_catalog "blast_demo" {
  code "OK" { description "Request is permitted" }
  code "BLOCKED" { description "Request is denied by policy" }
  code "NEW_RULE" { description "New policy rule added" }
}

decision_schema "rate_limit" {
  effects [allow, deny]
  default allow
  strategy first_match
}

decision_schema "geo_check" {
  effects [allow, deny]
  default allow
  strategy first_match
}

decision_schema "ip_reputation" {
  effects [allow, deny]
  default deny
  strategy first_match
}

decision_table "rate_limit" {
  default allow
  hit_policy first

  row "block-high-rate" {
    priority 100
    when { request.rate > 100 }
    then { decision deny }
    reason "rate limit exceeded"
    reason_code "BLOCKED"
  }

  row "block-medium-rate-high-risk" {
    priority 80
    when { all { request.rate > 75 request.country == "YY" } }
    then { decision deny }
    reason "elevated rate from restricted country"
    reason_code "NEW_RULE"
  }

  row "allow-normal-rate" {
    priority 50
    when { request.rate <= 50 }
    then { decision allow }
    reason "normal rate"
    reason_code "OK"
  }

  row "allow-low-rate" {
    priority 10
    when { request.rate <= 20 }
    then { decision allow }
    reason "low rate"
    reason_code "OK"
  }
}

decision_table "geo_check" {
  default allow
  hit_policy first

  row "block-restricted-geo" {
    priority 100
    when { any { request.country == "XX" request.country == "YY" request.country == "ZZ" } }
    then { decision deny }
    reason "restricted geography"
    reason_code "BLOCKED"
  }
}

decision_table "ip_reputation" {
  default deny
  hit_policy first

  row "allow-known-good" {
    priority 100
    when { request.ip_reputation >= 80 }
    then { decision allow }
    reason "good IP reputation"
    reason_code "OK"
  }
}

chain "access_chain" {
  entity "request.user_id"
  decisions ["rate_limit", "geo_check", "ip_reputation"]
  watch "rate_watch" {
    event "high_rate"
    window "5m"
    step "notify" { threshold 3 action "warn" severity "medium" ttl "10m" }
  }
  watch "ip_watch" {
    event "bad_ip"
    window "15m"
    step "block" { threshold 1 action "block" severity "high" ttl "60m" }
  }
}

lifecycle "request_lifecycle" {
  entity "request.user_id"
  phase "pre_process" {
    decision "geo_check"
    decision "ip_reputation"
  }
  phase "main" {
    decision "rate_limit"
    chain "access_chain"
  }
}

routes "api" {
  route "write_data" { method "POST" pattern "/api/data" decisions ["rate_limit", "geo_check", "ip_reputation"] chains ["access_chain"] }
}
